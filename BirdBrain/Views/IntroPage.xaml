<!--<views:BasePage-->
<ContentPage
    x:Class="BirdBrain.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BirdBrain.Controls"
    xmlns:views="clr-namespace:BirdBrain.Views"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- PAGE CONTENT -->
        <Grid>
            <!-- MENU PANEL (Hidden underneath) -->
            <VerticalStackLayout
                x:Name="MenuPanel"
                BackgroundColor="Transparent"
                Padding="30"
                Spacing="40"
                Opacity="0"
                TranslationY="0">
                <Grid RowDefinitions="4*,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    
                    <!-- Optional GPS Button -->
                    <SwipeView HeightRequest="60">

                        <!-- RIGHT SWIPE ACTION -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    Text="Use Location"
                                    BackgroundColor="{DynamicResource Accent}"
                                    IconImageSource="location.png"
                                    Invoked="OnUseLocationInvoked"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- MAIN CONTENT (Visible Area) -->
                        <Border
                            BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource Accent}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 30"
                            Padding="20,0"
                            HeightRequest="60">
                            <Label
                                Text="Swipe - Current Location"
                                VerticalOptions="Center"
                                TextColor="{DynamicResource TextPrimary}"
                                FontAttributes="Bold"/>
                        </Border>
                    </SwipeView>
                    
                    <Entry
                        Grid.Row="1"
                        x:Name="LocationEntry"
                        Placeholder="Enter location"
                        HeightRequest="55"
                        BackgroundColor="{DynamicResource Surface}"
                        TextColor="{DynamicResource TextPrimary}"
                        PlaceholderColor="{DynamicResource Accent}"/>
                </Grid>
                <VerticalStackLayout
                        Spacing="5">
                    <Label 
                            Text="Saved Locations"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"/>
                    <CarouselView
                            x:Name="LocationCarousel"
                            HeightRequest="80"   
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never"
                            BackgroundColor="{DynamicResource Background}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    WidthRequest="130"
                                    HeightRequest="50"
                                    Margin="5"
                                    Padding="10"
                                    BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource Accent}"
                                    StrokeShape="RoundRectangle 20">
                                
                                    <Label
                                        Text="{Binding}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        FontSize="14"
                                        FontAttributes="Bold"/>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView
                            x:Name="indicatorView"
                            HorizontalOptions="Center"
                            IndicatorColor="{DynamicResource Surface}"
                            SelectedIndicatorColor="{DynamicResource Accent}"/>
                </VerticalStackLayout>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="40"
                    Background="Transparent">
                    <Border
                        Stroke="{DynamicResource Accent}"
                        StrokeThickness="1"
                        HorizontalOptions="Start"
                        Padding="0"
                        BackgroundColor="{DynamicResource Surface}"
                        StrokeShape="RoundRectangle 20">
                        <Grid ColumnDefinitions="*,*"
                            HeightRequest="36">
                            <!-- All Birds TAB -->
                            <Border
                                x:Name="AllBirdsTab"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource Primary}"
                                Padding="12,6"
                                StrokeShape="RoundRectangle 20,0,0,20">
                                <Label
                                    Text="All Birds"
                                    TextColor="{DynamicResource TextOnPrimary}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAllBirdsTapped"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- BIRD TAB -->
                            <Border
                                x:Name="SpecificBirdTab"
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource Surface}"
                                Padding="12,6"
                                StrokeShape="RoundRectangle 0,20,20,0">
                                <Label
                                    Text="Specific Bird"
                                    TextColor="{DynamicResource TextPrimary}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpecificBirdTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                    
                </HorizontalStackLayout>

            </VerticalStackLayout>
            <!-- IMAGE LAYER (Covers screen initially) -->
            <Grid x:Name="ImageLayer" >
                <Image
                x:Name="AnimatedImage"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Opacity="0"
                Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>

    <!--</views:BasePage>-->
</ContentPage>
