<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BirdBrain.Controls.FooterView"
            
             xmlns:services="clr-namespace:BirdBrain.Services"
             x:DataType="services:AppState">
    <Grid>
        <HorizontalStackLayout Grid.Row="5" HorizontalOptions="Center">
            <Label Text="Radius - " Style="{StaticResource PageLabel}"/>
            <Label Text="{Binding Radius}" Style="{StaticResource PageLabel}"/>
            <Label Text =" km   |  Days - " Style = "{StaticResource PageLabel}" />
            <Label Text="{Binding Days}" Style="{StaticResource PageLabel}"/>
            <Label Text =" Days" Style="{StaticResource PageLabel}"/>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
