<toolkit:Popup
    Color="Transparent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="BirdBrain.Controls.ErrorPopup">

    <Border Style="{StaticResource RoundedAccentBorderStyle1}" Padding="5" WidthRequest="300"
        HorizontalOptions="Center" VerticalOptions="Center">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Image Grid.Column="0" VerticalOptions="Center" Source="{Binding Image}" />
            <VerticalStackLayout Grid.Column="1" Spacing="10">
                <Label Text="{Binding Title}" Style="{StaticResource SubTitles}" TextColor= "{DynamicResource Background}"
                   LineBreakMode="WordWrap" />
                <Label Text="{Binding Message}" Style="{StaticResource PageLabelNormal}" TextColor= "{DynamicResource Background}"
                   LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</toolkit:Popup>