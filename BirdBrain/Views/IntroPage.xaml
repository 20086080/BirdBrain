<!--<views:BasePage-->
<ContentPage
    x:Class="BirdBrain.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BirdBrain.Controls"
    xmlns:views="clr-namespace:BirdBrain.Views"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- PAGE CONTENT -->
        <Grid>
            <!-- MENU PANEL (Hidden underneath) -->
            <VerticalStackLayout x:Name="MenuPanel"
                BackgroundColor="{DynamicResource Surface}"
                Padding="30" Spacing="40" Opacity="0"
                TranslationY="0">
                <Grid RowDefinitions="4*,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    
                    <!-- Optional GPS Button -->
                    <SwipeView HeightRequest="60">

                        <!-- RIGHT SWIPE ACTION -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    Text="Use Location"
                                    BackgroundColor="{DynamicResource Accent}"
                                    IconImageSource="location.png"
                                    Invoked="OnUseLocationInvoked"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- MAIN CONTENT (Visible Area) -->
                        <Border Style="{StaticResource RoundedAccentBorderStyle}" HeightRequest="60">
                            <Label Text="Swipe - Current Location" Style="{StaticResource PageLabel}"/>
                        </Border>
                    </SwipeView>

                    <Entry
                        Grid.Row="1" x:Name="LocationEntry" 
                        Placeholder="Enter location" Style="{StaticResource PrimaryEntryStyle}" />
                </Grid>
                <VerticalStackLayout
                        Spacing="5">
                    <Label Text="Saved Locations" Style="{StaticResource PageLabel}" />
                    <CarouselView
                            x:Name="LocationCarousel"
                            HeightRequest="80"   
                            ItemsLayout="HorizontalList" HorizontalScrollBarVisibility="Never"
                            BackgroundColor="{DynamicResource Background}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RoundedAccentBorderStyle}"
                                    WidthRequest="130" HeightRequest="50">
                                    <Label Text="{Binding}" Style="{StaticResource PageLabel}"/>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView
                            x:Name="indicatorView"
                            HorizontalOptions="Center"
                            IndicatorColor="{DynamicResource Surface}"
                            SelectedIndicatorColor="{DynamicResource Accent}"/>
                </VerticalStackLayout>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="40"
                    Background="{DynamicResource Surface}">
                    <Border Style="{StaticResource RoundedAccentBorderStyle}" Padding="0"
                            HorizontalOptions="Start">
                        <Grid ColumnDefinitions="*,*"
                            HeightRequest="36">
                            <!-- All Birds TAB -->
                            <Border x:Name="AllBirdsTab" Grid.Column="0" Style="{StaticResource SelectorBorderStyle1}">
                                <Label Text="All Birds" Style="{StaticResource PageLabel}"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAllBirdsTapped"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- BIRD TAB -->
                            <Border
                                x:Name="SpecificBirdTab" Grid.Column="1" Style="{StaticResource SelectorBorderStyle2}" >
                                <Label Text="Specific Bird" Style="{StaticResource PageLabel}"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpecificBirdTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                    
                </HorizontalStackLayout>

            </VerticalStackLayout>
            <!-- IMAGE LAYER (Covers screen initially) -->
            <Grid x:Name="ImageLayer" >
                <Image
                x:Name="AnimatedImage"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Opacity="0"
                Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>

    <!--</views:BasePage>-->
</ContentPage>
