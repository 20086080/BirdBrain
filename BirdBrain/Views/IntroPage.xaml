<ContentPage
    x:Class="BirdBrain.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BirdBrain.Controls"
    BackgroundColor="{DynamicResource Background}">
    <Shell.NavBarIsVisible>false</Shell.NavBarIsVisible>
    <Grid RowDefinitions="Auto,*">
        <!-- HEADER -->
        <controls:HeaderView />

        <!-- PAGE CONTENT -->
        <Grid Grid.Row="1">
            <!-- MENU PANEL (Hidden underneath) -->
            <VerticalStackLayout
            x:Name="MenuPanel"
            BackgroundColor="Transparent"
            Padding="30"
            Spacing="25"
            Opacity="0"
            TranslationY="200">
                <Entry
                x:Name="LocationEntry"
                Placeholder="Enter location"
                HeightRequest="55"
                BackgroundColor="{DynamicResource Surface}"
                TextColor="{DynamicResource TextPrimary}"
                PlaceholderColor="{DynamicResource Accent}"
                />
                <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Start"
                HorizontalOptions="Fill"
                Background="Transparent">
                    <Label 
                    Text="Select Location"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimary}"
                    HorizontalOptions="Center"/>
                    <VerticalStackLayout
                    Spacing="5"
                    HorizontalOptions="Fill"
                    Background="Transparent">
                        <CarouselView
                        x:Name="LocationCarousel"
                        HeightRequest="80"
                        PeekAreaInsets="10"
                        IndicatorView="indicatorView"
                        BackgroundColor="{DynamicResource Background}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                    Margin="10"
                                    Padding="10"
                                    BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource Accent}">
                                        <Label
                                    Text="{Binding}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    FontSize="14"
                                    FontAttributes="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <IndicatorView
                        x:Name="indicatorView"
                        HorizontalOptions="Center"
                        IndicatorColor="{DynamicResource Surface}"
                        SelectedIndicatorColor="{DynamicResource Accent}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Optional GPS Button -->
                <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="40"
                Background="Transparent">
                    <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center"
                    Background="Transparent">
                        <Button
                        Text=""
                        HeightRequest="60"
                        WidthRequest="60"
                        CornerRadius="30"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        HorizontalOptions="Center"/>
                        <Label
                        Text="Current Location"
                        FontSize="14"
                        TextColor="{DynamicResource TextPrimary}"
                        HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Select Bird -->
                    <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center"
                    Background="Transparent">
                        <!-- SELECT BIRD BUTTON -->
                        <Button
                        x:Name="SelectBirdButton"
                        Text=""
                        HeightRequest="60"
                        WidthRequest="60"
                        HorizontalOptions="Center"
                        CornerRadius="30"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="{DynamicResource TextOnPrimary}"/>
                        <Label
                        Text="Select Bird"
                        FontSize="14"
                        TextColor="{DynamicResource TextPrimary}"
                        HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <!--Clicked="OnSelectBirdClicked"-->
            </VerticalStackLayout>


            <!-- IMAGE LAYER (Covers screen initially) -->
            <Grid x:Name="ImageLayer">
                <Image
                x:Name="AnimatedImage"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Opacity="0"
                Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
