<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BirdBrain.Controls.RightSettingsDrawer"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BirdBrain.Controls"
    xmlns:viewmodels="clr-namespace:BirdBrain.ViewModels"
    BackgroundColor="{DynamicResource Accent70}"         
    Padding="0" Margin= "0">
    <VerticalStackLayout Padding="20,20" Spacing="24" >
        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <Grid ColumnDefinitions="*,26" ColumnSpacing="12">
                <Label Grid.Column ="0" Text="Settings" Style="{StaticResource Titles}" />
                <Image Grid.Column ="1" Source="icon_exit.png" Style="{StaticResource DrawerMenuIconStyle}" />
            </Grid>
        </Grid>
        <BoxView Style="{StaticResource DrawerDividerStyle}" />

        <!-- Theme Section -->
        <VerticalStackLayout Spacing="12">
            <VerticalStackLayout.BindingContext>
                <viewmodels:ThemeViewModel />
            </VerticalStackLayout.BindingContext>
            <Label Text="Theme" Style="{StaticResource DrawerSectionLabelStyle}" />
            <CollectionView ItemsSource="{Binding Themes}" SelectionMode="Single"
                SelectedItem="{Binding SelectedTheme}" VerticalOptions="Start"
                            HeightRequest="250">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="6" Spacing="4">
                            <!-- Theme Name -->
                            <Label Text="{Binding Name}" Style="{StaticResource DrawerSectionLabelStyle}" FontSize="12" FontAttributes="None"/>
                            <!-- Color Preview Strip -->
                            <HorizontalStackLayout Spacing="1">
                                <BoxView Color="{Binding PreviewPrimary}" WidthRequest="22" HeightRequest="18"/>
                                <BoxView Color="{Binding PreviewAccent}" WidthRequest="22" HeightRequest="18"/>
                                <BoxView Color="{Binding PreviewBackground}" WidthRequest="22" HeightRequest="18"/>
                                <BoxView Color="{Binding PreviewSurface}" WidthRequest="22" HeightRequest="18"/>
                                <BoxView Color="{Binding PreviewTextPrimary}" WidthRequest="22" HeightRequest="18"/>
                                <BoxView Color="{Binding PreviewTextOnPrimary}" WidthRequest="22" HeightRequest="18"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <BoxView Style="{StaticResource DrawerDividerStyle}" />
        <Border Style="{StaticResource RoundedAccentBorderStyle}"  Padding="0" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,*" WidthRequest="250" HeightRequest="44" >

                <!-- Dark Mode Selector -->
                <Border x:Name="DarkTab"  Grid.Column="0" Style="{StaticResource SegmentSelectedStyle}">
                    <Label x:Name="DarkLabel" Text="Dark" Style="{StaticResource SegmentSelectedLabelStyle}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDarkTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!--  Light Mode Selector -->
                <Border x:Name="LightTab"  Grid.Column="1" Style="{StaticResource SegmentUnselectedStyle}">
                    <Label x:Name="LightLabel" Text="Light" Style="{StaticResource SegmentUnselectedLabelStyle}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLightTapped"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>
        </Border>
        <!-- Font Size Slider -->
        <VerticalStackLayout Spacing="8">
            <Label Text="Font Size" Style="{StaticResource DrawerSectionLabelStyle}" />
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Label Text="small" Style="{StaticResource SliderEndpointLabelStyle}" />
                <Slider Grid.Column="1" Style="{StaticResource DrawerSliderStyle}"
                    Minimum="1" Maximum="3"
                    Value="{Binding Radius, Mode=TwoWay,
                        Source={RelativeSource AncestorType={x:Type controls:LeftSettingsDrawer}}}" />
                <Label Text ="large"  Grid.Column="2" Style="{StaticResource SliderEndpointLabelStyle}" />
            </Grid>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
