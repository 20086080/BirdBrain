<!--<views:BasePage-->
<ContentPage
    x:Class="BirdBrain.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BirdBrain.Controls"
    xmlns:views="clr-namespace:BirdBrain.Views"
    Title="Location Selection"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Background}">

    <Grid>
        <!-- PAGE CONTENT -->
        <Grid>
            <!-- MENU PANEL (Hidden underneath) -->
            <VerticalStackLayout x:Name="MenuPanel"
                BackgroundColor="{DynamicResource Background}"
                Padding="30" Spacing="40" Opacity="0"
                TranslationY="0">
                <Grid RowDefinitions="5*,*"
                    ColumnSpacing="15"
                    HorizontalOptions="Fill">
                    <!-- Optional GPS Button -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Use Current Location" Style="{StaticResource PageLabel}" />
                        <Switch IsToggled="{Binding UseCurrentLocation}" Style="{StaticResource PrimarySwitchStyle}"/>
                    </HorizontalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Spacing="2">
                        <Entry x:Name="LocationEntry" Placeholder="Enter location" Style="{StaticResource PrimaryEntryStyle}" />
                        <BoxView Style="{StaticResource UnderlineStyle}"/>
                    </VerticalStackLayout>
                </Grid>


                <!-- ========================= -->
                <!-- 3️⃣ SAVED LOCATIONS (EXPANDS) -->
                <!-- ========================= -->
                <VerticalStackLayout Grid.Row="2" Spacing="15" Margin="0,30,0,0" VerticalOptions="FillAndExpand">
                    <Label Text="Saved Locations" Style="{StaticResource PageLabel}" HorizontalOptions="Center"/>
                    <CarouselView ItemsSource="{Binding MyCollection}"
                        x:Name="LocationCarousel" IndicatorView="LocationIndicator" VerticalOptions="FillAndExpand"
                        PeekAreaInsets="60">
                        <CarouselView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" SnapPointsType="MandatorySingle"
                                   SnapPointsAlignment="Center" ItemSpacing="5"/>
                        </CarouselView.ItemsLayout>
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="200" HorizontalOptions="Center">
                                    <Border Stroke="{DynamicResource Accent}" Style="{StaticResource CarouselBorder}">
                                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <Image Source="{Binding Image}" HeightRequest="110" Aspect="AspectFill" />
                                            <Label Text="{Binding Name}" Style="{StaticResource PageLabel}"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                    <IndicatorView x:Name="LocationIndicator" Style="{StaticResource PrimaryIndicatorStyle}"/>
                </VerticalStackLayout>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="40"
                    Background="{DynamicResource Background}">
                    <Border Style="{StaticResource RoundedAccentBorderStyle}" Padding="0"
                            HorizontalOptions="Start">
                        <Grid ColumnDefinitions="*,*" HeightRequest="36">
                            <!-- All Birds TAB -->
                            <Border x:Name="AllBirdsTab" Grid.Column="0" Style="{StaticResource SegmentSelectedStyle}">
                                <Label x:Name="AllBirdsLabel" Text="All Birds" Style="{StaticResource SegmentSelectedLabelStyle}"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAllBirdsTapped"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- BIRD TAB -->
                            <Border
                                x:Name="SpecificBirdTab" Grid.Column="1" Style="{StaticResource SegmentUnselectedStyle}" >
                                <Label x:Name="SpecificBirdLabel" Text="Specific Bird" Style="{StaticResource SegmentUnselectedLabelStyle}"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpecificBirdTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>

            </VerticalStackLayout>
            <!-- IMAGE LAYER (Covers screen initially) -->
            <Grid x:Name="ImageLayer" >
                <Image
                x:Name="AnimatedImage"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Opacity="0"
                Background="{DynamicResource Primary}"/>
            </Grid>
        </Grid>
    </Grid>

    <!--</views:BasePage>-->
</ContentPage>
