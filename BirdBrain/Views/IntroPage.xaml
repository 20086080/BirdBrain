<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BirdBrain.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BirdBrain.Views"
    Title="Location Selection"
    BackgroundColor="{DynamicResource Background}">

    <!-- Proper page grid -->
    <Grid Padding="20"
          RowSpacing="20"
          RowDefinitions="Auto,Auto,*,Auto">

        <!-- 1️⃣ GPS Toggle -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="12"
                               VerticalOptions="Center">
            <Label Text="Use Current Location"
                   Style="{StaticResource PageLabel}" />
            <Switch IsToggled="{Binding UseCurrentLocation}"
                    Style="{StaticResource PrimarySwitchStyle}" />
        </HorizontalStackLayout>

        <!-- 2️⃣ Location Entry -->
        <VerticalStackLayout Grid.Row="1" Spacing="2">
            <Entry x:Name="LocationEntry"
                   Placeholder="Enter location"
                   TextChanged="OnTextChanged"
                   Style="{StaticResource PrimaryEntryStyle}" />
            <BoxView Style="{StaticResource UnderlineStyle}" />
        </VerticalStackLayout>

        <!-- 3️⃣ SAVED LOCATIONS (Expands Fully) -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="15"
                             VerticalOptions="FillAndExpand">

            <Label Text="Saved Locations"
                   Style="{StaticResource PageLabel}"
                   HorizontalOptions="Center"/>

            <CarouselView ItemsSource="{Binding MyCollection}"
                          x:Name="LocationCarousel"
                          IndicatorView="LocationIndicator"
                          VerticalOptions="FillAndExpand"
                          HorizontalOptions="FillAndExpand"
                          PeekAreaInsets="60">

                <CarouselView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       SnapPointsType="MandatorySingle"
                                       SnapPointsAlignment="Center"
                                       ItemSpacing="10"/>
                </CarouselView.ItemsLayout>

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource Accent}"
                                Style="{StaticResource CarouselBorder}"
                                HorizontalOptions="Center"
                                WidthRequest="220">

                            <VerticalStackLayout Spacing="8"
                                                 Padding="10">
                                <Image Source="{Binding Image}"
                                       HeightRequest="130"
                                       Aspect="AspectFill" />

                                <Label Text="{Binding Name}"
                                       Style="{StaticResource CarouselLabel}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="LocationIndicator"
                           Style="{StaticResource PrimaryIndicatorStyle}"
                           HorizontalOptions="Center"/>

        </VerticalStackLayout>

        <!-- 4️⃣ Bottom Segmented Tabs (Anchored) -->
        <Border Grid.Row="3"
                Style="{StaticResource RoundedAccentBorderStyle}"
                Padding="0"
                HorizontalOptions="Center">

            <Grid ColumnDefinitions="*,*"
                  HeightRequest="44"
                  WidthRequest="300">

                <!-- All Birds TAB -->
                <Border x:Name="AllBirdsTab"
                        Grid.Column="0"
                        Style="{StaticResource SegmentSelectedStyle}">
                    <Label x:Name="AllBirdsLabel"
                           Text="All Birds"
                           Style="{StaticResource SegmentSelectedLabelStyle}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAllBirdsTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Specific Bird TAB -->
                <Border x:Name="SpecificBirdTab"
                        Grid.Column="1"
                        Style="{StaticResource SegmentUnselectedStyle}">
                    <Label x:Name="SpecificBirdLabel"
                           Text="Specific Bird"
                           Style="{StaticResource SegmentUnselectedLabelStyle}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSpecificBirdTapped"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>
        </Border>

    </Grid>
</views:BasePage>
