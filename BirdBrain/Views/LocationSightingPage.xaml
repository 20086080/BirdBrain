<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BirdBrain.Views.LocationSightingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BirdBrain.Views"
    xmlns:services="clr-namespace:BirdBrain.Services"
    xmlns:models="clr-namespace:BirdBrain.Models"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:DataType="services:AppState"
    Title="Location Sightings">
    
    <Grid RowDefinitions="Auto,Auto,Auto, Auto,Auto,*" Padding="10" RowSpacing="5">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" HeightRequest="45"
                       Spacing="10" Background="{DynamicResource Background}" >

            <!-- LOCATION / BIRD Selection -->
            <Border Style="{StaticResource RoundedAccentBorderStyle}" Padding="0" WidthRequest="200" HeightRequest="45">
                <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill" >
                    <!-- Location TAB -->
                    <Border x:Name="LocationTab" Grid.Column="0" Style="{StaticResource SegmentSelectedStyle}">
                        <Label x:Name="LocationTabLabel" Text="Location" Style="{StaticResource SegmentSelectedLabelStyle}"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="LocationTapped"/>
                            </Border.GestureRecognizers>
                    </Border>
                    
                    <!-- Bird TAB -->
                    <Border x:Name="BirdTab" Grid.Column="1" Style="{StaticResource SegmentUnselectedStyle}">
                        <Label x:Name="BirdTabLabel" Text="Bird" Style="{StaticResource SegmentUnselectedLabelStyle}"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BirdTapped"/>
                            </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>
        </HorizontalStackLayout>
        <BoxView Grid.Row="1" Style="{StaticResource UnderlineStyle}" />
        
        <!-- LOCATION LABEL -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" 
              Background="{DynamicResource Background}" HeightRequest="140">
            <VerticalStackLayout Grid.Column="1" Spacing="5">
                <Label Text = "{Binding SelectedSavedLocation.Name}" Style="{StaticResource SubTitles}"/>
                <HorizontalStackLayout >
                    <Label Text = "{Binding SelectedSavedLocation.Lat}" Style="{StaticResource PageLabelNormal}" HorizontalOptions="Start"/>
                    <Label Text = ", " Style="{StaticResource PageLabelNormal}"/>
                    <Label Text = "{Binding SelectedSavedLocation.Lng}" Style="{StaticResource PageLabelNormal}"/>
                </HorizontalStackLayout >
                <Label Text = "{Binding SelectedSavedLocation.Region}" Style="{StaticResource PageLabelNormal}"/>
                <Label Text = "{Binding SelectedSavedLocation.Country}" Style="{StaticResource PageLabelNormal}"/>
            </VerticalStackLayout>
            <Border Padding="0" Grid.Column="0">
                <Image Source="{Binding SelectedSavedLocation.Thumbnail}" HeightRequest="130" Aspect="AspectFill"/>
            </Border>
        </Grid>
        <BoxView Grid.Row="3" Style="{StaticResource UnderlineStyle}"/>

        
        <Grid Grid.Row="4" ColumnDefinitions="*,1.3*" >
            <!-- SIGHTING STATS -->
            <Border Grid.Column ="0" Margin ="0,20,0,0" Padding="5,5,5,5" Style ="{DynamicResource RoundedAccentBorderStyle}" VerticalOptions="Start" 
                           Background="{DynamicResource Accent}">
                <Grid ColumnDefinitions="1.4*,*" RowDefinitions="Auto,Auto" RowSpacing="5">
                    <Label Grid.Row="0"  Grid.Column="0" Padding="5,10,5,10" Text="Sightings" Style="{StaticResource PageLabelCenter}" 
                           TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="15"/>
                    <Label Grid.Row="1" Grid.Column="0" Padding="5,10,5,10" Text="# Birds" Style="{StaticResource PageLabelCenter}" 
                           TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="15"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalSightings}" Style="{StaticResource PageLabelCenter}" 
                           TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="17"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalTypeOfBird}" Style="{StaticResource PageLabelCenter}" 
                            TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="17"/>
                    <BoxView Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource VerticallineStyle}" HorizontalOptions="End" 
                           Color="{DynamicResource Background}" />
                    <BoxView Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource UnderlineStyle}" VerticalOptions="End"
                           Color="{DynamicResource Background}"/>
                    
                </Grid>
            </Border>
            <Border Grid.Column ="1" Padding="5" HeightRequest="140" Style ="{DynamicResource RoundedAccentBorderStyle}">
            <ScrollView VerticalScrollBarVisibility="Always">
                <CollectionView ItemsSource="{Binding TopBirds}">
                    <CollectionView.Header>
                        <Grid ColumnDefinitions="*,*" RowDefinitions =" *,*" Padding="5">
                            <Label Text="Birds" Grid.Row ="0" Style="{StaticResource PageLabelNormal}" HorizontalOptions="Start"/>
                            <Label Grid.Column="1" Grid.Row ="0" Text="# Sightings" Style="{StaticResource PageLabelNormal}" 
                                   HorizontalOptions="Center"/>
                            <BoxView Grid.Row ="1" Grid.ColumnSpan ="2" Style="{StaticResource UnderlineStyle}"/>
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TopBirds">
                            <Grid ColumnDefinitions="2*,*" Padding="2" ColumnSpacing="5">
                                <Label Text="{Binding BirdName}" Style="{StaticResource PageLabelNormal}" HorizontalOptions="Start" />
                                <Label Grid.Column="1" Text="{Binding Sightings}" HorizontalTextAlignment="Center" 
                                       HorizontalOptions="Center" Style="{StaticResource PageLabelNormal}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Border>
        </Grid>
        <!-- DAILY SIGHTINGS Grid.Row = 3-->
        <Border Padding="5" Grid.Row="5" Style ="{DynamicResource RoundedAccentBorderStyle}" Background="{DynamicResource Surface}">
            <VerticalStackLayout>
                <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                    Background="{DynamicResource Surface}" DrawMarginFrame="{x:Null}" HeightRequest="155"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
