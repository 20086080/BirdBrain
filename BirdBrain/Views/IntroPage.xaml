<views:BasePage
    x:Class="BirdBrain.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BirdBrain.Views"
    Title="Location Selection"
    BackgroundColor="{DynamicResource Background}">

    <Grid RowSpacing="10" Padding ="5" RowDefinitions="Auto, Auto, Auto, Auto, Auto,*,Auto, Auto">
        <HorizontalStackLayout Grid.Row="0" Spacing="5" >
            <Label Text="Use Current Location" Style="{StaticResource PageLabel}" />
            <Switch IsToggled="{Binding UseCurrentLocation}" Style="{StaticResource PrimarySwitchStyle}" />
        </HorizontalStackLayout>
        <BoxView Grid.Row ="1" Style="{StaticResource UnderlineStyle}" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions ="Auto,Auto" >
            <Label Grid.Row="0" Grid.Column="0"
                    Text="{Binding State.SelectedSavedLocation.Lat, StringFormat='Latitude | Longitude     {0},'}" Style="{StaticResource SubTitles}" />
            <Label Grid.Row="0" Grid.Column="1"
                    Text="{Binding State.SelectedSavedLocation.Lng, StringFormat=' {0}'}" Style="{StaticResource SubTitles}" />
            <!--        <Label Grid.Row ="1" Grid.Column ="0" Text="Location Selection " Style="{StaticResource PageLabel}" />
           <Entry Grid.Row ="1" Grid.Column ="1" x:Name="LocationEntry" Text="{Binding State.SelectedSavedLocation.Name}" 
                   TextChanged="OnTextChanged"  Style="{StaticResource PrimaryEntryStyle}" />  -->
        </Grid>

        <VerticalStackLayout Grid.Row="3">
            <SearchBar x:Name="SearchBox" Placeholder="Search location..." Style="{StaticResource PageLabel}"
                            TextChanged="OnSearchTextChanged" ZIndex="1"/>
            <Border x:Name="DropdownBorder" ZIndex="10" Style="{StaticResource RoundedAccentBorderStyle}" Padding="0" Margin="0" 
                            IsVisible="False">
                
                <CollectionView x:Name="ResultsList" HeightRequest="200"
                        ItemsSource="{Binding FilteredLocations}"
                        SelectionMode="Single" SelectionChanged="OnItemSelected"
                                InputTransparent="False">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" RowDefinitions="Auto,1">
                                <Label Text="{Binding DisplayText}" Style="{StaticResource PageLabel}"/>
                                <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="{DynamicResource Background}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>

        <BoxView Grid.Row ="4" Style="{StaticResource UnderlineStyle}" />

        <VerticalStackLayout Grid.Row="5" >
            <Label Text="Saved Locations Selection" Style="{StaticResource PageLabel}" HorizontalOptions="Center"/>
            <CarouselView ItemsSource="{Binding State.SavedLocations}" 
                          x:Name="LocationCarousel"
                          IndicatorView="LocationIndicator" 
                          VerticalOptions="Fill" HorizontalOptions="Fill" 
                          PeekAreaInsets="70">

                <CarouselView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" SnapPointsType="MandatorySingle"
                                       SnapPointsAlignment="Center" ItemSpacing="10"/>
                </CarouselView.ItemsLayout>

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{DynamicResource Accent}"
                                Style="{StaticResource CarouselBorder}"
                                WidthRequest="220">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnLocationTapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5" Padding="5">
                                <Image Source="{Binding Thumbnail}" HeightRequest="130" Aspect="AspectFill" 
                                       IsVisible="{Binding Source={x:Reference LocationCarousel}, Path=IsVisible}"/>
                                <Label Text="{Binding Name}" Style="{StaticResource CarouselLabel}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView x:Name="LocationIndicator" Style="{StaticResource PrimaryIndicatorStyle}"
                           HorizontalOptions="Center" Padding="5"/>
        </VerticalStackLayout>

        <BoxView Grid.Row ="6" Style="{StaticResource UnderlineStyle}" />

        <Border Grid.Row="7" Style="{StaticResource RoundedAccentBorderStyle}" Padding="0" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,*" HeightRequest="40" WidthRequest="220">
                <Border x:Name="AllBirdsTab"  Grid.Column="0" Style = "{StaticResource SegmentSelectedStyle}" IsEnabled="{Binding HasLocation}">
                    <Label x:Name="AllBirdsLabel" Text="All Birds" Style="{StaticResource SegmentSelectedLabelStyle}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAllBirdsTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="SpecificBirdTab"  Grid.Column="1"
                        Style="{StaticResource SegmentUnselectedStyle}" IsEnabled="{Binding HasLocation}">
                    <Label x:Name="SpecificBirdLabel" Text="Specific Bird"
                           Style="{StaticResource SegmentUnselectedLabelStyle}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSpecificBirdTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>
    </Grid>
</views:BasePage>
    
