
<views:BasePage
    x:Class="BirdBrain.Views.BirdSightingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BirdBrain.Views"
    xmlns:services="clr-namespace:BirdBrain.Services"
    xmlns:models="clr-namespace:BirdBrain.Models"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    
    Title="Bird Sightings">

    <Grid RowDefinitions="Auto,Auto,Auto, Auto,Auto,Auto" Padding="10" >

        <!-- LOCATION / BIRD Selection -->
            <Border Style="{StaticResource RoundedAccentBorderStyle}" Padding="0" WidthRequest="175" HeightRequest="35" HorizontalOptions="Start">
                <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill" >
                    <!-- Location TAB -->
                    <Border x:Name="LocationTab" Grid.Column="0" Style="{StaticResource SegmentUnSelectedStyle}">
                        <Label x:Name="LocationTabLabel" Text="Location" Style="{StaticResource SegmentUnSelectedLabelStyle}"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="LocationTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Bird TAB -->
                    <Border x:Name="BirdTab" Grid.Column="1" Style="{StaticResource SegmentSelectedStyle}">
                        <Label x:Name="BirdTabLabel" Text="Bird" Style="{StaticResource SegmentSelectedLabelStyle}"/>
                        
                    </Border>
                </Grid>
            </Border>
        
        <BoxView Grid.Row="1" Style="{StaticResource UnderlineStyle}" Margin="0,5,0,5"/>

        <!-- Bird LABEL -->
        <Grid Grid.Row="2" ColumnDefinitions="*,1.5*"  Background="{DynamicResource Background}" >
            <Image Grid.Column="0" Source="{Binding State.SelectedSavedBird.Thumbnail}" HorizontalOptions="Start" HeightRequest="128" Aspect="AspectFit"/>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Text = "{Binding State.SelectedSavedBird.CommonName}" Style = "{StaticResource SubTitles}"/>
                <Label Grid.Row ="1" Text = "{Binding State.SelectedSavedLocation.Name}" Style="{StaticResource PageLabelNormal}" FontAttributes ="Bold" FontSize="14"/>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                    <Label Grid.Column="0" Text = "{Binding State.SelectedSavedLocation.Lat}" Style="{StaticResource PageLabelNormal}" HorizontalOptions="Start"/>
                    <Label Grid.Column="1" Text = ", " Style="{StaticResource PageLabelNormal}"/>
                    <Label Grid.Column="2" Text = "{Binding State.SelectedSavedLocation.Lng}" Style="{StaticResource PageLabelNormal}"/>
                </Grid>
                <Label Grid.Row ="3" Text = "{Binding State.SelectedSavedLocation.Region}" Style="{StaticResource PageLabelNormal}"/>
                <Label Grid.Row ="4" Text = "{Binding State.SelectedSavedLocation.Country}" Style="{StaticResource PageLabelNormal}"/>
            </Grid>
        </Grid>
        <BoxView Grid.Row="3" Style="{StaticResource UnderlineStyle}" Margin="0,5,0,5"/>

        <Grid Grid.Row="4" ColumnDefinitions="*,1.3*" >
            <!-- SIGHTING STATS -->
            <Grid Grid.Column = "0" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <Border Grid.Column ="0" Grid.Row ="0"  Style ="{DynamicResource RoundedAccentBorderStyle}" VerticalOptions="Start" 
                           Background="{DynamicResource Accent}">
                    <Grid ColumnDefinitions="1.4*,*" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Label Grid.Row="0"  Grid.Column="0" Padding="5" Text="# Obs" Style="{StaticResource PageLabelCenter}" 
                            TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="16"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding BirdSightings}" Style="{StaticResource PageLabelCenter}" 
                            TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="17"/>

                        <Label Grid.Row="1" Grid.Column="0" Padding="5" Text="# Birds" Style="{StaticResource PageLabelCenter}" 
                           TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="16"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalBirds}" Style="{StaticResource PageLabelCenter}" 
                            TextColor="{DynamicResource Background}" FontAttributes="Bold" FontSize="17"/>

                        <BoxView Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource VerticallineStyle}" HorizontalOptions="End" 
                            Color="{DynamicResource Background}" />
                        <BoxView Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource UnderlineStyle}" VerticalOptions="End"
                            Color="{DynamicResource Background}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Padding="5">
                    <Label Grid.Column = "0" Text = "{Binding BirdSightings,StringFormat= 'Seen {0} days out of'}" Style="{StaticResource PageLabelNormal}"/>
                    <Label Grid.Column = "1" Text = "{Binding NumberDays, StringFormat= ' {0}'}" Style="{StaticResource PageLabelNormal}"/>
                </Grid>
                <Label Grid.Row = "3" Text = "{Binding DistinctLocations, StringFormat ='Obs at {0} Locations'}" Style="{StaticResource PageLabelNormal}" Padding="5,0"/>
                <HorizontalStackLayout Grid.Row = "4">
                    <Label Text = "{Binding ObsDtLatest, StringFormat = 'Last seen {0}'}" Style="{StaticResource PageLabelNormal}" Padding="5"/>
                    <Label Text = "{Binding LatLatest,   StringFormat = ' {0},'}" Style="{StaticResource PageLabelNormal}" Padding="5"/>
                    <Label Text = "{Binding LngLatest,   StringFormat = ' {0}'}" Style="{StaticResource PageLabelNormal}" Padding="5"/>
                </HorizontalStackLayout> 
           </Grid>

            <Border Grid.Row="0" Grid.Column="1" Style ="{DynamicResource NormalAccentBorderStyle}">
                <CollectionView ItemsSource="{Binding BirdTimeObs}">
                    <CollectionView.Header>
                        <Grid ColumnDefinitions="1.4*,*,*" RowDefinitions="*,*" >
                            <Label Text="Top Times" Grid.Row ="0" FontSize="14" Style="{StaticResource PageLabelNormal}" HorizontalOptions="Start"/>
                            <Label Grid.Column="1" Grid.Row ="0" Text="# Birds" Style="{StaticResource PageLabelCenter}" 
                                                HorizontalOptions="End"/>
                            <Label Grid.Column="2" Grid.Row ="0" Text="%" Style="{StaticResource PageLabelCenter}" 
                                                HorizontalOptions="Center"/>
                            <BoxView Grid.Row ="1" Grid.ColumnSpan ="3" Margin ="0,5,0,5" Style="{StaticResource UnderlineStyle}"/>
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5,5,5,0" ColumnDefinitions="*,*,*" >
                                <Label Grid.Column="0" Text="{Binding ObsDt}" Style="{StaticResource PageLabelNormal}" />
                                <Label Grid.Column="1" Text="{Binding Sightings}" Style="{StaticResource PageLabelCenter}"/>
                                <Label Grid.Column="2" Text="{Binding PercOff}" Style="{StaticResource PageLabelCenter}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
        
        <!-- DAILY SIGHTINGS Grid.Row = 3-->
        <Border Padding="5" Grid.Row="5" HeightRequest ="150" VerticalOptions ="End" Style ="{DynamicResource RoundedAccentBorderStyle}" Background="{DynamicResource Surface}">
            <VerticalStackLayout>
                <lvc:CartesianChart Series="{Binding BirdSeries}" XAxes="{Binding BirdXAxes}" YAxes="{Binding BirdYAxes}"
                    Background="{DynamicResource Surface}" DrawMarginFrame="{x:Null}" HeightRequest="125"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
