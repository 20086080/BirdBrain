<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BirdBrain.Controls.FooterView"
            
             xmlns:services="clr-namespace:BirdBrain.Services"
             x:DataType="services:AppState">
    <Grid RowDefinitions="*,*"  Padding="5" RowSpacing="0">
        <BoxView Grid.Row="0" Style="{StaticResource UnderlineStyle}" />
        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" >
            <Label Text="{Binding Radius, StringFormat = 'Radius - {0}'}" Style="{StaticResource PageLabel}" FontAttributes="Italic" />
            <Label Text="{Binding Days, StringFormat = ' km   |  Days - {0}'}" Style="{StaticResource PageLabel}" FontAttributes="Italic"/>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
